      "number": 32,
      "sha256": "6f862c23a000a722aa3345d67c1ea0aa08bc65e0bd478e1f85efd7325cfedb8b",
      "audio": "audio/lessons/stories-miso-types-reading/marin-b72765ceddb99bf200e2.mp3",
      "transcript": "一方、味噌を焼いたり炒めたりすると、加熱によって香ばしい風味が生まれます。",
      "model": "whisper-1",
      "expected_text_prompt": false
