      "number": 21,
      "sha256": "3eb5cbe39afa295b21ff825b612dd4c24912c1581bf59f94d63ac4ed74fa7e62",
      "audio": "audio/lessons/fermentation-notes-miso/marin-b0836de46ebe55c62a45.mp3",
      "transcript": "3.専用容器の内側をアルコール消毒し、縁を7センチメートルほど折り返しておきます。",
      "model": "whisper-1",
      "expected_text_prompt": false
