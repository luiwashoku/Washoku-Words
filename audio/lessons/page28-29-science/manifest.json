  "にほんしゅ。 こめず。 こうじあまざけ。 しょうゆ": "audio/lessons/page28-29-science/nova-1bac781971010164c299.mp3",
  "にほんしゅ": "audio/lessons/page28-29-science/nova-1eef0536327720d50d47.mp3",
  "こめず": "audio/lessons/page28-29-science/nova-a96d95f90de8b34f86e3.mp3",
